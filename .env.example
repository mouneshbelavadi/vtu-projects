# Base URL of the website (http://localhost:3000 locally, https://projects.vtuadda.com in production)
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anonymous API key safe for browser use (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role secret key for server-only operations (Supabase Dashboard -> Project Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for sending emails (Resend Dashboard -> API Keys)
RESEND_API_KEY=

# Sender email address for outgoing emails (configured domain in Resend, e.g., no-reply@projects.vtuadda.com)
EMAIL_FROM=

# Secret token for authenticating scheduled cron jobs (generate a random string of 32 or more characters)
CRON_SECRET=

# Secret salt for HMAC-SHA256 IP address hashing (generate a random string of 32 or more characters)
IP_HASH_SALT=
