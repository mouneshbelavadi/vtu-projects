{
  "name": "vtuadda-projects",
  "version": "0.1.0",
  "private": true,
  "description": "Project store for VTU students",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "audit": "npm audit --omit=dev --audit-level=high",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.13.9",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.21.0",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.30",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.7"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
